{
	"extends": "expo/tsconfig.base",
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"noUncheckedIndexedAccess": true,
		"strict": true,
		"paths": {
			"@/*": ["./*"]
		},
		"types": ["react", "react-native"]
	},
	"include": [
		"app",
		"src/client/components/native",
		"src/client/expo",
		"src/client/env.d.ts",
		"src/client/features/nativePreferences",
		"src/client/features/nativeServers",
		"src/client/lib/workbenchLayout.ts",
		"src/shared",
		"expo-env.d.ts"
	],
	"exclude": ["**/*.test.ts", "**/*.test.tsx"]
}
