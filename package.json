{
	"name": "couchview",
	"version": "0.1.0",
	"private": true,
	"description": "A compact local-first Git diff review PWA powered by Bun.",
	"type": "module",
	"packageManager": "bun@1.3.14",
	"engines": {
		"bun": ">=1.3.0"
	},
	"bin": {
		"couchview": "./src/server/cli.ts"
	},
	"scripts": {
		"dev": "bun run scripts/dev.ts",
		"start": "bun run src/server/cli.ts",
		"build": "vite build",
		"build:binary": "bun run build && bun build ./src/server/cli.ts --compile --minify --sourcemap --no-compile-autoload-dotenv --no-compile-autoload-bunfig --outfile ./dist/couchview",
		"preview": "bun run src/server/cli.ts",
		"typecheck": "tsc --noEmit",
		"benchmark:quality": "bun run scripts/benchmarkQualityChecks.ts",
		"benchmark:quality:update": "bun run scripts/updateQualityBenchmarkBaseline.ts",
		"format": "biome check --write --linter-enabled=false .",
		"format:all": "biome format --write .",
		"format:check": "biome check --linter-enabled=false .",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write --unsafe .",
		"check:architecture": "bun run scripts/checkArchitecture.ts && biome lint --only=lint/suspicious/noImportCycles .",
		"check:commit:static": "bun run scripts/checkStagedQuality.ts",
		"check:commit": "bun run check:commit:static && bun run benchmark:quality",
		"check:quality": "bun run check:architecture && bun run format:check && bun run lint && bun run typecheck && bun test src scripts && bun run build",
		"test": "bun test src scripts",
		"test:binary": "bun run scripts/smokeCompiledBinary.ts",
		"test:integration:tmux": "bun test tests/integration/remote-terminal-tmux.test.ts",
		"test:watch": "bun test --watch src",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"@pierre/diffs": "1.2.12",
		"cmdk": "1.1.1",
		"ghostty-web": "0.4.0",
		"lucide-react": "^1.25.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"simple-git": "3.36.0",
		"werift": "0.23.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.6",
		"@happy-dom/global-registrator": "^20.11.0",
		"@playwright/test": "^1.61.1",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.3",
		"bun-types": "^1.3.14",
		"happy-dom": "^20.11.0",
		"typescript": "^7.0.2",
		"vite": "^8.1.5",
		"vite-plugin-pwa": "^1.3.0"
	}
}
