{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noEmit": true,
		"skipLibCheck": true,
		"types": ["bun-types", "vite/client", "vite-plugin-pwa/client"]
	},
	"include": ["src", "scripts", "tests", ".codex/hooks", "vite.config.ts", "playwright.config.ts"],
	"exclude": [
		"src/client/components/native",
		"src/client/expo",
		"src/client/features/nativePreferences",
		"src/client/features/nativeServers"
	]
}
